# Environment variables configuration

# Routine default settings
ROUTINE_DEFAULT_TIMEOUT_MS=60000
ROUTINE_DEFAULT_ENABLED=true
ROUTINE_DEFAULT_RUN_IN_SYNC=false
ROUTINE_DEFAULT_HIDDEN=false
ROUTINE_DEFAULT_CONTINUE_ON_ERROR=true
ROUTINE_DEFAULT_AUTO_CHECK_CONDITIONS_EVERY_MS=0

# Task default settings
TASK_RETRY_ATTEMPTS=3
TASK_RETRY_DELAY_MS=5000
TASK_DEFAULT_TIMEOUT_MS=60000

# Application settings
DEFAULT_LANGUAGE=es
ENCRYPTION_PASSWORD=your-encryption-password-here
CURRENT_PROJECT_FILENAME=currentProject.dc2
AUTOCHECK_LICENSE_INTERVAL_HOURS=1

# Update service settings (headless/webpack builds only)
# How often (in hours) to check GitHub for a new release within the same major version
UPDATE_CHECK_INTERVAL_HOURS=1
# Fine-grained GitHub PAT with "Contents: read" ONLY on the deviceControl2 repo.
# Required because the repo is private: without it, checking for updates and
# downloading release assets will fail. Rotate if it ever leaks.
GITHUB_UPDATE_TOKEN=your-readonly-github-token-here

# Email configuration
EMAIL_HOST=smtp.example.com
EMAIL_SSL=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password-here

# System settings (for privileged operations like network configuration)
# This password is used to run sudo commands for network management
SYSTEM_USER_PASSWORD=your-system-password-here

# Screen settings
# Duracion (ms) de la transicion de brillo al encender, apagar o cambiar el brillo de pantalla
SCREEN_BRIGHTNESS_TRANSITION_MS=700

# Network settings (Linux only - wired ethernet configuration)
# Fallback static IP applied when DHCP fails on first run, or when a manual
# IP change made from the settings panel fails to establish connectivity within its timeout.
DEFAULT_STATIC_IP=192.168.10.1
DEFAULT_STATIC_SUBNET_MASK=255.255.255.0
# Max time (ms) to wait for DHCP to yield a valid IP on the very first run before falling back
NETWORK_FIRST_RUN_DHCP_TIMEOUT_MS=20000
# Max time (ms) to wait for a manually-applied IP change to establish connectivity before reverting
NETWORK_CHANGE_VERIFY_TIMEOUT_MS=15000